# PROPOSED systemd unit — the founder installs it; the bot does not install
# itself. Survives a crash or reboot (Restart=always, WantedBy=multi-user).
#
# Two ways to run it; pick one:
#
#  (A) Docker (matches docker-compose.yml). Install:
#        sudo cp deploy/hardbasis-bot.service /etc/systemd/system/
#        sudo systemctl daemon-reload && sudo systemctl enable --now hardbasis-bot
#      This unit as written uses the Docker path.
#
#  (B) Bare pnpm. Swap ExecStart for:  /usr/bin/pnpm start   (WorkingDirectory
#      the checkout, User a non-root service account) and drop the ExecStartPre.
#
# Logs go to journald AND to the rotated files under the state volume; journald
# is size-capped by /etc/systemd/journald.conf (SystemMaxUse=), so a 1 GB
# droplet is safe either way.

[Unit]
Description=HardBasis reference/soak bot (testnet)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/hardbasis-bot
# Rebuild-on-the-box, the way an outside trader would (dogfoods the README).
ExecStartPre=/usr/bin/docker compose pull --quiet
ExecStart=/usr/bin/docker compose up --build
ExecStop=/usr/bin/docker compose down
Restart=always
RestartSec=5
# Don't thrash on a hard-down dependency (e.g. gateway offline).
StartLimitIntervalSec=300
StartLimitBurst=10

[Install]
WantedBy=multi-user.target
