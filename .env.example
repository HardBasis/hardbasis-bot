# HardBasis reference bot — configuration.
#
# Copy to `.env` and edit. The ONLY value a stranger must set is HB_BASE_URL
# (and it already defaults to testnet). The bot self-bootstraps its own account,
# faucet grant, and trade-scoped delegate on first run — you provision NO key.
#
# .env is gitignored. Never commit a real key. CI fails on anything matching
# hb_[0-9a-f]{32}.

# ── Required-ish ────────────────────────────────────────────────────────────
# Base URL of the gateway. Testnet is the only public environment today.
HB_BASE_URL=https://testnet.hardbasis.com

# ── Safety ──────────────────────────────────────────────────────────────────
# The bot calls GET /deployment on startup and REFUSES to trade anywhere that
# is not "testnet". Set to 1 only if you truly mean to run against another
# deployment and you accept the risk. Leave unset for the safe default.
HB_ALLOW_NON_TESTNET=0

# ── Self-limiting caps (all integers; sane defaults baked in) ────────────────
# Max absolute open position, in contracts ($1-notional each).
HB_MAX_POSITION_CONTRACTS=2000
# Max contracts traded per rolling 24h before the loop idles.
HB_MAX_DAILY_TURNOVER_CONTRACTS=200000
# Order size per flip, in contracts.
HB_ORDER_CONTRACTS=500
# Hard ceiling on signups this process may ever perform (bootstrap needs 1).
HB_MAX_SIGNUPS=1
# Hard ceiling on faucet draws. The long soak deliberately accumulates past the
# ~0.1 BTC first-seen confirmation threshold to exercise the 428 flow, which
# needs ~12–15 draws (the faucet is rate-limited, so this takes a few hours).
HB_MAX_FAUCET_DRAWS=15

# Exercise the first-seen withdrawal confirmation flow (HTTP 428) end to end
# during the unattended soak (accumulate → quote → tokenless-refuse → confirm).
# Set to 0 to disable (the short smoke, `--once`, never runs it).
HB_EXERCISE_CONFIRM=1
# Pace between faucet draws while accumulating (ms), and the max wait honored on
# a faucet 429 before retrying.
HB_FAUCET_PACE_MS=60000
HB_FAUCET_MAX_WAIT_MS=1800000

# ── Timing (milliseconds) ───────────────────────────────────────────────────
# Trading-loop tick.
HB_TICK_MS=15000
# cancel-all-after deadline the bot keeps armed and refreshes.
HB_DEADMAN_MS=60000

# ── Logging ─────────────────────────────────────────────────────────────────
HB_LOG_DIR=./logs
HB_STATE_DIR=./state
# Per-file size cap (bytes) before rotation; keeps a 1 GB droplet safe.
HB_LOG_MAX_BYTES=5000000
# Rotated files kept per sink.
HB_LOG_MAX_FILES=5

# ── Alerts (optional; leave blank to disable) ───────────────────────────────
# A generic webhook (POST JSON) and/or an ntfy topic URL. An invariant
# violation on an unwatched VM is invisible without one of these.
HB_ALERT_WEBHOOK_URL=
HB_ALERT_NTFY_URL=
# Set to 1 to fire ONE alert at startup (through the same path a real finding
# uses) so you can prove alerts escape the box before trusting them for days.
HB_ALERT_SELFTEST=0
